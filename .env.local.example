# ============================================
# DATABASE (Neon Postgres)
# ============================================
# Get from https://console.neon.tech/ after creating a project.
# Use the POOLED connection string for DATABASE_URL (works with serverless).
# Use the DIRECT (non-pooled) connection string for DIRECT_DATABASE_URL — Prisma needs this for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DB?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DB?sslmode=require"

# ============================================
# AUTH
# ============================================
# Must be at least 32 chars. Generate with: openssl rand -base64 32
AUTH_SECRET="please-generate-a-real-secret-at-least-32-characters-long"

# ============================================
# SEED DATA (used by `npm run db:seed` only)
# ============================================
SEED_ADMIN_EMAIL="admin@theliftingsocial.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Founder"

# ============================================
# CLOUDINARY (product image uploads)
# ============================================
# Get from https://cloudinary.com/console after creating a free account.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================
# PAYHERE (Sri Lankan payment gateway)
# ============================================
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_MODE="sandbox"

# ============================================
# APP URL (used for PayHere callbacks + OG metadata)
# ============================================
# Local dev: http://localhost:3000
# Production: e.g. https://foods.theliftingsocial.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
