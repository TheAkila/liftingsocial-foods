# PayHere credentials (get from https://www.payhere.lk/account/merchant)
# Use sandbox values for testing; switch to live when going to production.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# "sandbox" (default) or "live"
PAYHERE_MODE=sandbox

# Your site URL — used for PayHere return/notify URLs.
# Local dev: http://localhost:3000
# Production: e.g. https://foods.theliftingsocial.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
